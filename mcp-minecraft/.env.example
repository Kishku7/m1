# ---- MCP-Minecraft configuration (all values optional; defaults shown) ----

# Target socket to bridge (the program you want to talk to).
# Use "localhost" so an IPv6-only listener is reachable too.
TARGET_HOST=localhost
TARGET_PORT=26000

# HTTP server that exposes the MCP endpoint (/mcp) and the health endpoint (/health).
# BIND_HOST=0.0.0.0 makes it reachable from other machines (e.g. Claude Desktop on
# your LAN). There is NO authentication -- only expose it on a trusted network.
BIND_HOST=0.0.0.0
PORT=26001

# Reconnect backoff to the target socket (milliseconds).
RECONNECT_MIN_MS=500
RECONNECT_MAX_MS=3000

# Reply framing.
#   REPLY_SENTINEL: if set, send_command reads until a line that EXACTLY equals it,
#     giving deterministic replies (recommended when the target emits one). Leave
#     empty to fall back to quiet-period timing (generic default).
#   QUIET_MS: silence gap that marks a reply complete when REPLY_SENTINEL is empty.
#   SEND_TIMEOUT_MS: overall cap for collecting a reply.
REPLY_SENTINEL=
QUIET_MS=300
SEND_TIMEOUT_MS=15000

# On-connect behaviour.
#   CONNECT_INIT: a line sent once right after connecting (e.g. "RAW ON").
#   DISCARD_CONNECT_BANNER: drain+discard whatever the target emits on connect
#     (greeting/banner and the CONNECT_INIT reply) so it never pollutes the first
#     command's reply. Automatically enabled when CONNECT_INIT is set.
#   PRIME_QUIET_MS: silence gap that marks the banner drain complete.
CONNECT_INIT=
DISCARD_CONNECT_BANNER=false
PRIME_QUIET_MS=400

# listen: how long a single listen() call blocks waiting for output before it
# returns NO-DATA-KEEPALIVE (milliseconds).
LISTEN_WINDOW_MS=30000

# ---- Example: driving the M1 Minecraft mod ----
# TARGET_PORT=26000
# REPLY_SENTINEL=<<END
# CONNECT_INIT=RAW ON
# DISCARD_CONNECT_BANNER=true
